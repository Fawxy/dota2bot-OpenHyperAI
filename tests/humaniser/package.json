{
    "name": "humaniser-offline-tests",
    "private": true,
    "description": "Offline checks for the humaniser Lua: syntax over bots/, behaviour tests against stubbed Dota globals, and the telemetry analyser (tools/hlog).",
    "scripts": {
        "syntax": "node syntax_check.js ../../bots",
        "test": "node run.js",
        "mining": "node ../../tools/replay-mining/test/run.js",
        "hlog": "node --test ../../tools/hlog/test/hlog.test.js ../../tools/hlog/test/bars.test.js ../../tools/hlog/test/dynamic.test.js ../../tools/hlog/test/nf.test.js ../../tools/hlog/test/lineup_check.test.js ../../tools/hlog/test/batch.test.js",
        "check": "npm run syntax && npm test && npm run fixtures && npm run mining && npm run hlog",
        "fixtures": "node --test fixtures.test.js && node fixtures.js",
        "fixtures:controls": "node fixtures.js --controls"
    },
    "devDependencies": {
        "fengari": "0.1.4",
        "luaparse": "0.3.1",
        "yaml": "2.5.1"
    }
}
